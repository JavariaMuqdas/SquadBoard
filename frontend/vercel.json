{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-RENDER-APP.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://YOUR-RENDER-APP.onrender.com/sanctum/:path*" },
    { "source": "/oauth/:path*", "destination": "https://YOUR-RENDER-APP.onrender.com/oauth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}